<?xml version="1.0" encoding="UTF-8"?>
<!-- Put this file in the IIS site's physical folder (e.g. C:\inetpub\hadiyah). It forwards everything to the Node service. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Hadiyah" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- uploads up to 30 MB (portal PDFs / images) -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
