# انسخ هذا الملف إلى .env وعدّل القيم
PORT=3000
# رابط قاعدة البيانات الموحّدة
DATABASE_URL=postgres://hadiyah:غيّر_كلمة_المرور@localhost:5432/hadiyah
# حساب مدير PostgreSQL: يُستخدم فقط في npm run db:create لإنشاء القاعدة والمستخدم
PG_ADMIN_URL=postgres://postgres:كلمة_مرور_postgres@localhost:5432/postgres
# سر توقيع الجلسات: قيمة عشوائية طويلة (مثلاً: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
# كلمة مرور المدير الأولى (تُستخدم عند أول npm run db:seed)
ADMIN_PASSWORD=
ORG_NAME=هدية الخير
# 1 عند التشغيل خلف HTTPS
COOKIE_SECURE=0
# 1 إذا كان خلف وسيط عكسي (IIS أو nginx) ليُقرأ عنوان العميل الحقيقي
TRUST_PROXY=0
# 1 لجعل بوابة الموظفين مفتوحة بلا دخول (كما كانت على الشبكة الداخلية)؛ الأنظمة الأخرى تبقى بدخول
PORTAL_PUBLIC=0
