{
  "name": "hadiyah-platform",
  "version": "1.0.0",
  "description": "المنصة الموحّدة لهدية الحاج: بوابة الموظفين وأرصدة الإجازات وبطاقة الموظف والتقارير على PostgreSQL",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "db:create": "node server/db/create-db.js",
    "db:init": "node server/db/init.js",
    "db:seed": "node server/db/seed.js",
    "db:seed:demo": "node server/db/seed.js --demo",
    "db:import-legacy": "node server/db/import-legacy.js",
    "setup": "npm run db:create && npm run db:seed && npm run db:import-legacy",
    "build:card": "python3 modules/card/tools/build.py",
    "test": "node --test test/*.test.js",
    "build:icons": "node scripts/build-icons.mjs",
    "db:migrate": "node server/db/migrate.js",
    "db:backup": "node server/db/backup.js",
    "db:report": "node server/db/report-duplicates.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "lucide-static": "^1.62.0"
  }
}
